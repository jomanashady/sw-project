    {
      "name": "Get All Pay Grades✅",
      "method": "GET",
      "url": "http://localhost:5000/api/v1/payroll-configuration/pay-grades",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer YOUR_JWT_TOKEN"
        }
      ],
      "params": [
        {
          "name": "status",
          "value": "draft",
          "description": "Filter by status: draft, approved, rejected"
        },
        {
          "name": "page",
          "value": "1"
        },
        {
          "name": "limit",
          "value": "10"
        }
      ]
    },
