# Root .gitignore for HR Management System

# Environment variables
.env
.env.local
.env.*.local
*.env

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Temporary files
*.tmp
.temp/

# Deployment files (optional - you may want to keep these)
# Uncomment if you don't want to commit deployment configs
# render.yaml
# vercel.json

